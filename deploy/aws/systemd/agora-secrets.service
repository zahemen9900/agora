[Unit]
Description=Render Agora runtime secrets from SSM
After=network-online.target
Wants=network-online.target
Before=agora.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/agora/current/scripts/render_secrets.py
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
